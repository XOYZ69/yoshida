{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "yoshida",
	"version": "../../web/package.json",
	"identifier": "dev.xoyz.yoshida",
	"build": {
		"devUrl": "http://localhost:5173",
		"frontendDist": "../../web/dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "yoshida",
				"width": 1400,
				"height": 900,
				"minWidth": 800,
				"minHeight": 500
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico",
			"icons/icon.png"
		],
		"category": "Graphics",
		"shortDescription": "Make cards from JSON designs and card data",
		"externalBin": ["binaries/yoshida-server"],
		"resources": { "../../web/dist/": "web/" }
	}
}
