# Settings for `docker compose up`. Copy this file to .env and edit the copy:
#
#   cp .env.example .env
#
# .env is not committed, so a token in it stays on this machine. Without a
# .env the server runs with its defaults. The server and Docker page of the
# docs describes every option.

# --- Build ---
# dev stamps the build as a preview (a red DEV beside the version). Empty: a plain build.
YOSHIDA_CHANNEL=

# --- Container ---
# The port on this machine that reaches the server (the container listens on 8080).
YOSHIDA_PUBLISH_PORT=8080
# Set by the image, leave them alone: YOSHIDA_WEB=/web, YOSHIDA_PORT=8080.
# YOSHIDA_HOST (default 0.0.0.0) is the address the server listens on inside the container.

# --- Server ---
# 1: the server can render whole sets. 0: editor only, rendering stays in the browser.
YOSHIDA_RENDER=0
YOSHIDA_MAX_CARDS=1000
YOSHIDA_MAX_BODY_MB=200
# Default: all CPUs.
#YOSHIDA_THREADS=4

# --- Usage statistics (docs: Usage Statistics) ---
# Counts are stored only in this container's data folder.
# 0: no statistics at all.
#YOSHIDA_TELEMETRY=0
# off, basic or advanced: the level the notice preselects.
#YOSHIDA_TELEMETRY_DEFAULT=basic
# off or basic: locks the level for everybody.
#YOSHIDA_TELEMETRY_FORCE=off
# Days of counts to keep, or infinite.
YOSHIDA_TELEMETRY_RETENTION_DAYS=365
# 1: count visitors by the first X-Forwarded-For address. Only behind a reverse proxy you control.
#YOSHIDA_TELEMETRY_TRUST_PROXY=1
# Where the counts are stored: in the container's /data folder, which
# compose.yaml keeps in the volume yoshida-data. Leave this line alone unless
# you mount your own folder somewhere else; a folder you mount must be writable
# for uid 65534, the user the server runs as.
#YOSHIDA_TELEMETRY_DIR=/data
# Enables the admin page at /admin/telemetry. At least 16 characters, a shorter
# or empty value leaves the page off. Use a long random value, for example the
# output of `openssl rand -hex 24`. Keep it in .env only, never in a committed file.
YOSHIDA_ADMIN_TOKEN=
