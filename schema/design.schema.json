                    "description": "Number literal or expression, see https://yoshida.xoyz.dev/docs/expressions/",
                    "type": ["number", "string"]
                  },
                  "y": {
                    "description": "Number literal or expression, see https://yoshida.xoyz.dev/docs/expressions/",
                    "type": ["number", "string"]
                  },
                  "align": {
                    "description": "Which end of the line sits at x (row) or y (column)",
                    "enum": ["start", "center", "end"]
                  },
                  "cross": {
                    "description": "Which side of every child sits at y (row) or x (column)",
                    "enum": ["start", "center", "end"]
                  }
                }
              },
              "include": {
                "description": "Takes the layers from a component file (a path from the project folder) instead of \"layers\"",
                "type": "string"
