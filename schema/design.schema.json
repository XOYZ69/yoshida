                          "properties": {
                            "color": {
                              "description": "Color literal (#RRGGBB, #RRGGBBAA, 12 or 16 digit) or expression",
                              "type": "string"
                            },
                            "at": {
                              "description": "Position along the gradient, 0 to 1",
                              "type": ["number", "string"]
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
