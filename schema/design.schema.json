{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoshida.local/schema/v1/design.schema.json",
  "title": "yoshida design (format 1)",
  "type": "object",
  "required": ["format", "name", "canvas", "layers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": 1 },
    "name": { "type": "string" },
    "note": { "type": "string" },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": {
          "description": "Number literal or expression (FORMAT.md section 6)",
          "type": ["number", "string"]
        },
        "height": {
          "description": "Number literal or expression (FORMAT.md section 6)",
          "type": ["number", "string"]
        },
        "background": {
          "description": "Color literal (#RRGGBB, #RRGGBBAA, 12 or 16 digit) or expression",
          "type": "string"
        }
      }
    },
    "fonts": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": "string" }
    },
    "params": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/param" }
    },
    "layers": {
      "type": "array",
      "items": { "$ref": "#/$defs/layer" }
    }
  },
  "$defs": {
    "param": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["number", "integer", "text", "bool", "color", "enum", "image", "list"]
        },
        "default": {},
        "required": { "type": "boolean" },
        "label": { "type": "string" },
        "note": { "type": "string" },
        "group": { "type": "string", "description": "Editor section the param is shown in" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "max_length": { "type": "integer", "minimum": 0 },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "item": {
          "type": "object",
          "additionalProperties": {
            "enum": ["number", "integer", "text", "bool", "color"]
          }
        }
      }
    },
    "layer": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Unique layer id"
        },
        "type": {
          "enum": ["rect", "ellipse", "polygon", "text", "image", "group", "divider"]
        },
        "note": { "type": "string" },
        "label": { "type": "string", "description": "Divider title shown in the editor's layer list" },
        "visible": {
          "description": "Boolean literal or expression",
          "type": ["boolean", "string"]
        },
        "opacity": {
          "description": "0 to 1",
          "type": ["number", "string"]
        },
        "rotate": {
          "description": "Degrees clockwise around the anchor point (polygons: their centre)",
          "type": ["number", "string"]
        },
        "anchor": {
          "enum": [
            "top-left",
            "top",
            "top-right",
            "left",
            "center",
            "right",
            "bottom-left",
            "bottom",
            "bottom-right",
            "baseline-left",
            "baseline",
            "baseline-right"
          ]
        },
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "count": {
              "description": "Number literal or expression (FORMAT.md section 6)",
              "type": ["number", "string"]
            },
            "each": { "type": "string" },
            "index": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "item": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
          }
        },
        "extends": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": ["crop", "fade", "sharpen", "detail", "edge_enhance", "find_edges"]
              },
              "side": {
                "enum": ["top", "bottom", "left", "right"]
              },
              "length": {
                "description": "Number literal or expression (FORMAT.md section 6)",
                "type": ["number", "string"]
              },
              "strength": {
                "description": "Number literal or expression (FORMAT.md section 6)",
                "type": ["number", "string"]
              }
            }
          }
        },
        "box": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "description": "Number literal or expression (FORMAT.md section 6)",
              "type": ["number", "string"]
            },
            "y": {
              "description": "Number literal or expression (FORMAT.md section 6)",
              "type": ["number", "string"]
            },
            "w": {
              "type": ["number", "string"]
            },
            "h": {
              "type": ["number", "string"]
            }
          }
        },
        "fill": {
          "description": "Color literal (#RRGGBB, #RRGGBBAA, 12 or 16 digit) or expression",
          "type": "string"
        },
        "radius": {
          "description": "Number literal or expression (FORMAT.md section 6)",
          "type": ["number", "string"]
        },
        "stroke": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "description": "Color literal (#RRGGBB, #RRGGBBAA, 12 or 16 digit) or expression",
              "type": "string"
            },
            "width": {
              "description": "Number literal or expression (FORMAT.md section 6)",
              "type": ["number", "string"]
            }
          }
        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": ["number", "string"]
            }
          }
        },
        "closed": { "type": "boolean" },
        "text": { "description": "Text with {expression} placeholders", "type": "string" },
        "at": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "description": "Number literal or expression (FORMAT.md section 6)",
              "type": ["number", "string"]
            },
            "y": {
              "description": "Number literal or expression (FORMAT.md section 6)",
              "type": ["number", "string"]
            }
          }
        },
        "font": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "size": {
          "description": "Number literal or expression (FORMAT.md section 6)",
          "type": ["number", "string"]
        },
        "color": {
          "description": "Color literal (#RRGGBB, #RRGGBBAA, 12 or 16 digit) or expression",
          "type": "string"
        },
        "align": {
          "enum": ["left", "center", "right", "justify"]
        },
        "wrap": {
          "description": "Number literal or expression (FORMAT.md section 6)",
          "type": ["number", "string"]
        },
        "line_spacing": {
          "description": "Number literal or expression (FORMAT.md section 6)",
          "type": ["number", "string"]
        },
        "max_lines": {
          "description": "Number literal or expression (FORMAT.md section 6)",
          "type": ["number", "string"]
        },
        "max_width": {
          "description": "Auto-shrink: reduce size until the block is at most this wide",
          "type": ["number", "string"]
        },
        "max_height": {
          "description": "Auto-shrink: reduce size until the block is at most this tall",
          "type": ["number", "string"]
        },
        "min_size": {
          "description": "Smallest size auto-shrink may use (default 8)",
          "type": ["number", "string"]
        },
        "src": { "description": "Text with {expression} placeholders", "type": "string" },
        "fit": {
          "enum": ["fill", "contain", "cover"]
        },
        "smoothing": {
          "enum": ["nearest", "bilinear"]
        },
        "layers": {
          "type": "array",
          "description": "Layers inside a group, first is bottom",
          "items": { "$ref": "#/$defs/layer" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "rect" }
            }
          },
          "then": {
            "properties": {
              "id": true,
              "type": true,
              "note": true,
              "visible": true,
              "opacity": true,
              "rotate": true,
              "anchor": true,
              "repeat": true,
              "extends": true,
              "effects": true,
              "box": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "description": "Number literal or expression (FORMAT.md section 6)",
                    "type": ["number", "string"]
                  },
                  "y": {
                    "description": "Number literal or expression (FORMAT.md section 6)",
                    "type": ["number", "string"]
                  },
                  "w": {
                    "type": ["number", "string"]
                  },
                  "h": {
                    "type": ["number", "string"]
                  }
                }
              },
              "fill": {
                "description": "Color literal (#RRGGBB, #RRGGBBAA, 12 or 16 digit) or expression",
                "type": "string"
              },
              "radius": {
                "description": "Number literal or expression (FORMAT.md section 6)",
                "type": ["number", "string"]
              },
              "stroke": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "color": {
                    "description": "Color literal (#RRGGBB, #RRGGBBAA, 12 or 16 digit) or expression",
                    "type": "string"
                  },
                  "width": {
                    "description": "Number literal or expression (FORMAT.md section 6)",
                    "type": ["number", "string"]
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "ellipse" }
            }
          },
          "then": {
            "properties": {
              "id": true,
              "type": true,
              "note": true,
              "visible": true,
              "opacity": true,
              "rotate": true,
              "anchor": true,
              "repeat": true,
              "extends": true,
              "effects": true,
              "box": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "description": "Number literal or expression (FORMAT.md section 6)",
                    "type": ["number", "string"]
                  },
                  "y": {
                    "description": "Number literal or expression (FORMAT.md section 6)",
                    "type": ["number", "string"]
                  },
                  "w": {
                    "type": ["number", "string"]
                  },
                  "h": {
                    "type": ["number", "string"]
                  }
                }
              },
              "fill": {
                "description": "Color literal (#RRGGBB, #RRGGBBAA, 12 or 16 digit) or expression",
                "type": "string"
              },
              "stroke": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "color": {
                    "description": "Color literal (#RRGGBB, #RRGGBBAA, 12 or 16 digit) or expression",
                    "type": "string"
                  },
                  "width": {
                    "description": "Number literal or expression (FORMAT.md section 6)",
                    "type": ["number", "string"]
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "polygon" }
            }
          },
          "then": {
            "properties": {
              "id": true,
              "type": true,
              "note": true,
              "visible": true,
              "opacity": true,
              "rotate": true,
              "anchor": true,
              "repeat": true,
              "extends": true,
              "effects": true,
              "points": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": ["number", "string"]
                  }
                }
              },
              "closed": { "type": "boolean" },
              "fill": {
                "description": "Color literal (#RRGGBB, #RRGGBBAA, 12 or 16 digit) or expression",
                "type": "string"
              },
              "stroke": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "color": {
                    "description": "Color literal (#RRGGBB, #RRGGBBAA, 12 or 16 digit) or expression",
                    "type": "string"
                  },
                  "width": {
                    "description": "Number literal or expression (FORMAT.md section 6)",
                    "type": ["number", "string"]
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "text" }
            }
          },
          "then": {
            "properties": {
              "id": true,
              "type": true,
              "note": true,
              "visible": true,
              "opacity": true,
              "rotate": true,
              "anchor": true,
              "repeat": true,
              "extends": true,
              "effects": true,
              "text": { "description": "Text with {expression} placeholders", "type": "string" },
              "at": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "description": "Number literal or expression (FORMAT.md section 6)",
                    "type": ["number", "string"]
                  },
                  "y": {
                    "description": "Number literal or expression (FORMAT.md section 6)",
                    "type": ["number", "string"]
                  }
                }
              },
              "font": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "size": {
                "description": "Number literal or expression (FORMAT.md section 6)",
                "type": ["number", "string"]
              },
              "color": {
                "description": "Color literal (#RRGGBB, #RRGGBBAA, 12 or 16 digit) or expression",
                "type": "string"
              },
              "align": {
                "enum": ["left", "center", "right", "justify"]
              },
              "wrap": {
                "description": "Number literal or expression (FORMAT.md section 6)",
                "type": ["number", "string"]
              },
              "line_spacing": {
                "description": "Number literal or expression (FORMAT.md section 6)",
                "type": ["number", "string"]
              },
              "max_lines": {
                "description": "Number literal or expression (FORMAT.md section 6)",
                "type": ["number", "string"]
              },
              "max_width": {
                "description": "Auto-shrink: reduce size until the block is at most this wide",
                "type": ["number", "string"]
              },
              "max_height": {
                "description": "Auto-shrink: reduce size until the block is at most this tall",
                "type": ["number", "string"]
              },
              "min_size": {
                "description": "Smallest size auto-shrink may use (default 8)",
                "type": ["number", "string"]
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "image" }
            }
          },
          "then": {
            "properties": {
              "id": true,
              "type": true,
              "note": true,
              "visible": true,
              "opacity": true,
              "rotate": true,
              "anchor": true,
              "repeat": true,
              "extends": true,
              "effects": true,
              "src": { "description": "Text with {expression} placeholders", "type": "string" },
              "box": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "description": "Number literal or expression (FORMAT.md section 6)",
                    "type": ["number", "string"]
                  },
                  "y": {
                    "description": "Number literal or expression (FORMAT.md section 6)",
                    "type": ["number", "string"]
                  },
                  "w": {
                    "type": ["number", "string"]
                  },
                  "h": {
                    "type": ["number", "string"]
                  }
                }
              },
              "fit": {
                "enum": ["fill", "contain", "cover"]
              },
              "smoothing": {
                "enum": ["nearest", "bilinear"]
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "group" }
            }
          },
          "then": {
            "required": ["layers"],
            "properties": {
              "id": true,
              "type": true,
              "note": true,
              "visible": true,
              "opacity": true,
              "rotate": true,
              "effects": true,
              "layers": true
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "divider" }
            }
          },
          "then": {
            "properties": {
              "id": true,
              "type": true,
              "note": true,
              "label": true
            },
            "additionalProperties": false
          }
        }
      ]
    }
  }
}
