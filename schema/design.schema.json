              "id": true,
              "type": true,
              "note": true,
              "visible": true,
              "opacity": true,
              "rotate": true,
              "anchor": true,
              "repeat": true,
              "extends": true,
              "effects": true,
              "text": {
                "description": "What the code holds: text with {expression} placeholders, for example a link",
                "type": "string"
              },
              "box": {
                "description": "The code is drawn as a square with whole pixels per module, centred in this box",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "description": "Number literal or expression, see https://yoshida.xoyz.dev/docs/expressions/",
                    "type": ["number", "string"]
                  },
                  "y": {
                    "description": "Number literal or expression, see https://yoshida.xoyz.dev/docs/expressions/",
                    "type": ["number", "string"]
                  },
                  "w": {
                    "type": ["number", "string"]
                  },
                  "h": {
                    "type": ["number", "string"]
                  }
                }
              },
              "color": {
                "description": "Color of the dark modules. Default black",
                "type": "string"
              },
              "fill": {
                "description": "Color behind the code, quiet zone included. Default white; #00000000 for none",
                "type": "string"
              },
              "margin": {
                "description": "Quiet zone around the code in modules, 0 to 16. Default 4",
                "type": ["number", "string"]
              },
              "level": {
                "description": "Error correction: low (7%), medium (15%, default), quartile (25%) or high (30%)",
