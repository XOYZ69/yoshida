              },
              "font_bold": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "font_italic": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "font_bold_italic": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "icon_scale": {
