{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoshida.local/schema/v1/yoshida.schema.json",
  "title": "yoshida project manifest (format 1)",
  "type": "object",
  "required": ["format"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": 1 },
    "name": { "type": "string" },
    "note": { "type": "string" },
    "sets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["design"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "design": { "type": "string" },
          "cards": { "type": "string" }
        }
      }
    }
  }
}
