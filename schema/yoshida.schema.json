{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoshida.local/schema/v1/yoshida.schema.json",
  "title": "yoshida project manifest (format 1)",
  "type": "object",
  "required": ["format"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": 1 },
    "name": { "type": "string" },
    "note": { "type": "string" },
    "utc_offset": {
      "type": "number",
      "minimum": -14,
      "maximum": 14,
      "description": "Hours from UTC for render.date and render.time (default 0)."
    },
    "sets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["design"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "design": { "type": "string" },
          "cards": { "type": "string" }
        }
      }
    }
  }
}
