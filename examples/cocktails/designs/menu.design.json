        { "name": "Aperitif alkoholfrei", "en": "Alcohol-free bitter aperitif" },
        { "name": "Aperol", "en": "Aperol" },
        { "name": "Blue Curaçao", "en": "Blue curaçao" },
        { "name": "Blue Curaçao Sirup", "en": "Blue curaçao syrup" },
        { "name": "Bombay Sapphire Gin", "en": "Bombay Sapphire gin" },
        { "name": "Cachaça", "en": "Cachaça" },
