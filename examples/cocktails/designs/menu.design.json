        { "name": "Weißer Rum", "en": "White rum" },
        { "name": "Whiskey", "en": "Whiskey" },
        { "name": "Zitronensaft", "en": "Lemon juice" },
        { "name": "Zuckersirup", "en": "Sugar syrup" }
      ],
      "label": "Ingredient names",
      "note": "German and English names; the same ingredients as in the card catalog."
    }
  },
  "functions": {
    "tr": {
      "args": { "de_text": "text", "en_text": "text" },
      "expr": "lang == 'en' ? en_text : de_text"
    },
    "dec": {
      "args": { "x": "number", "d": "number" },
      "expr": "lang == 'en' ? fmt(x, d) : replace(fmt(x, d), '.', ',')"
    },
    "pct": {
      "args": { "v": "number" },
      "expr": "dec(v, v == floor(v) ? 0 : 1)"
    },
    "nm": {
      "args": { "x": "text" },
      "expr": "x == 'none' ? '' : tr(x, get(catalog, x, 'en', x))",
      "note": "Ingredient name in the page language."
    },
    "sep": {
      "args": { "x": "text" },
      "expr": "x == 'none' ? '' : ', '"
    },
    "level": {
      "args": { "v": "number" },
      "expr": "v <= 0 ? 0 : v < 8 ? 1 : v < 14 ? 2 : v < 20 ? 3 : 4",
      "note": "Strength 0 to 4 from % vol."
    }
  },
  "consts": {
    "cx": 2480,
    "ink": "mix(accent, #24121C, 0.72)",
    "soft": "mix(accent, #FFFFFF, 0.86)",
    "paper": "mix(#FFFFFF, accent, 0.04)",
    "muted": "mix(ink, paper, 0.45)",
    "col_w": 2080,
    "row_h": 1320,
    "grid_top": 1200
  },
  "layers": [
    {
      "id": "page",
      "type": "group",
      "layers": [
        {
          "id": "bleed_fill",
          "type": "rect",
          "box": { "x": 0, "y": 0, "w": "canvas.w", "h": "canvas.h" },
          "fill": "accent"
        },
        {
          "id": "panel",
          "type": "rect",
          "box": { "x": 160, "y": 160, "w": "canvas.w - 320", "h": "canvas.h - 320" },
          "fill": "soft",
          "radius": 180
        },
        {
          "id": "stitch",
          "type": "rect",
          "box": { "x": 220, "y": 220, "w": "canvas.w - 440", "h": "canvas.h - 440" },
          "fill": "#00000000",
          "radius": 140,
          "stroke": {
            "color": "with_alpha(accent, 0.5)",
            "width": 12,
            "dash": [0.2, 40]
          }
        }
      ]
    },
    {
      "id": "header",
      "type": "group",
      "layers": [
        {
          "id": "menu_title",
          "type": "text",
          "text": "{title}",
          "anchor": "center",
          "font": "script",
          "size": 500,
          "color": "ink",
          "max_width": 3600,
          "min_size": 240,
          "at": { "x": "cx", "y": 640 }
        },
        {
          "id": "menu_sub",
          "type": "text",
          "text": "{upper(subtitle)}",
          "anchor": "center",
          "font": "bold",
          "size": 112,
          "color": "muted",
          "max_width": 3600,
          "min_size": 60,
          "at": { "x": "cx", "y": 1000 }
        }
      ]
    },
    {
      "id": "entries",
      "type": "group",
      "layers": [
        {
          "id": "entry",
          "type": "group",
          "layers": [
            {
              "id": "cell",
              "type": "rect",
              "box": { "x": 0, "y": 0, "w": "col_w", "h": "row_h - 120" },
              "fill": "paper",
              "radius": 120,
              "stroke": { "color": "with_alpha(accent, 0.35)", "width": 8 }
            },
            {
              "id": "swatch_ring",
              "type": "ellipse",
              "anchor": "center",
              "box": { "x": 300, "y": "(row_h - 120) / 2", "w": 380, "h": 380 },
              "fill": "#FFFFFF",
              "stroke": { "color": "accent", "width": 16 }
            },
            {
              "id": "swatch",
              "type": "ellipse",
              "anchor": "center",
              "box": { "x": 300, "y": "(row_h - 120) / 2", "w": 300, "h": 300 },
              "fill": "d.color"
            },
            {
              "id": "d_name",
              "type": "text",
              "text": "{d.drink}",
              "anchor": "left",
              "font": "script",
              "size": 172,
              "color": "ink",
              "max_width": 1000,
              "min_size": 88,
              "shrink_group": "menu_names",
              "at": { "x": 580, "y": 240 }
            },
            {
              "id": "d_tag",
              "type": "text",
              "text": "{d.tagline}",
              "anchor": "left",
              "font": "body",
              "size": 68,
              "color": "muted",
              "max_width": 800,
              "min_size": 44,
              "at": { "x": 580, "y": 430 }
            },
            {
              "id": "d_ing",
              "type": "text",
              "text": "{nm(d.i1)}{sep(d.i2)}{nm(d.i2)}{sep(d.i3)}{nm(d.i3)}{sep(d.i4)}{nm(d.i4)}{sep(d.i5)}{nm(d.i5)}{sep(d.i6)}{nm(d.i6)}",
              "anchor": "top-left",
              "font": "body",
              "size": 80,
              "color": "ink",
              "wrap": 1320,
              "line_spacing": 20,
              "max_lines": 4,
              "at": { "x": 580, "y": 600 }
            },
            {
              "id": "d_vol",
              "type": "text",
              "text": "{d.vol > 0 ? pct(d.vol) : ''}{d.vol > 0 ? ' % vol' : tr('alkoholfrei', 'alcohol-free')}",
              "anchor": "right",
              "font": "bold",
              "size": 80,
              "color": "ink",
              "at": { "x": "col_w - 120", "y": 430 }
            },
            {
              "id": "d_drop",
              "type": "ellipse",
              "anchor": "center",
              "repeat": { "count": 4, "index": "k" },
              "box": { "x": "col_w - 120 - 52 - (3 - k) * 92", "y": 250, "w": 64, "h": 64 },
              "fill": "k < level(d.vol) ? accent : #00000000",
              "stroke": { "color": "accent", "width": 10 }
            }
          ],
          "repeat": { "each": "drinks", "item": "d", "index": "i" },
          "translate": {
            "x": "320 + (i % 2) * (col_w + 160)",
            "y": "grid_top + floor(i / 2) * row_h"
          }
        }
      ]
    },
    {
      "id": "foot_note",
      "type": "text",
      "anchor": "center",
      "font": "body",
      "size": 68,
      "color": "muted",
      "text": "{tr('% vol: Alkoholgehalt des fertigen Getränks', '% vol: alcohol by volume of the finished drink')}",
      "at": { "x": "cx", "y": "canvas.h - 380" }
    }
  ]
}
