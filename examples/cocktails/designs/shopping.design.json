  "functions": {
    "tr": {
      "args": { "de_text": "text", "en_text": "text" },
      "expr": "lang == 'en' ? en_text : de_text"
    },
    "dec": {
      "args": { "x": "number", "d": "number" },
      "expr": "lang == 'en' ? fmt(x, d) : replace(fmt(x, d), '.', ',')"
    },
    "num": {
      "args": { "x": "number" },
      "expr": "x == floor(x) ? fmt(x, 0) : dec(x, 1)"
    },
    "name_of": {
      "args": { "x": "text" },
      "expr": "tr(x, get(catalog, x, 'en', x))"
    },
    "need": {
      "args": { "unit": "text", "amount": "number", "drink": "text" },
      "expr": "(unit == 'cl' ? amount : unit == 'ml' ? amount / 10 : amount) * 10 * get(party, drink, 'servings', 0) * (1 + reserve / 100)",
      "note": "Needed amount times ten (cl, or pieces or spoons) for all servings of one drink, with the reserve."
    },
    "unit_of": {
      "args": { "x": "text" },
      "expr": "get(catalog, x, 'unit', 'cl') == 'tsp' ? tr('TL', 'tsp') : get(catalog, x, 'unit', 'cl') == 'pc' ? tr('Stk', 'pcs') : 'cl'"
    }
  },
  "consts": {
    "cx": 2480,
    "ink": "mix(accent, #24121C, 0.72)",
    "soft": "mix(accent, #FFFFFF, 0.86)",
    "paper": "mix(#FFFFFF, accent, 0.04)",
    "muted": "mix(ink, paper, 0.45)",
    "nrows": "len(recipes)",
    "list_top": 1540,
    "list_h": 4660,
    "party_pitch": "min(168, 4000 / max(len(party), 1))"
  },
  "layers": [
    {
      "id": "calc",
      "type": "group",
      "layers": [
        {
          "id": "need_acc",
          "type": "rect",
          "repeat": { "each": "recipes", "item": "rc", "index": "r" },
          "box": {
            "x": "(r == 0 ? false : recipes[r - 1].ingredient == rc.ingredient) ? @need_acc[r - 1].bounds.right : 0",
            "y": 0,
            "w": "need(rc.unit, rc.amount, rc.drink)",
            "h": 2
          },
          "note": "Running total per ingredient: the rows are sorted, so a box starts where the previous one of the same ingredient ends."
        },
        {
          "id": "line_acc",
          "type": "rect",
          "repeat": { "each": "recipes", "item": "rc", "index": "r" },
          "box": {
            "x": "r == 0 ? 0 : @line_acc[r - 1].bounds.right",
            "y": 0,
            "w": "(r + 1 < nrows ? recipes[r + 1].ingredient != rc.ingredient : true) ? (@need_acc[r].bounds.right > 0 ? 1 : 0) : 0",
            "h": 2
          },
          "note": "Counts the lines to draw (the last row of every ingredient that is needed): the end of a box is the line number."
        },
        {
          "id": "shop_lines",
          "type": "rect",
          "box": {
            "x": 0,
            "y": 0,
            "w": "nrows > 0 ? @line_acc[nrows - 1].bounds.right : 0",
            "h": 2
          },
          "note": "Number of lines."
        }
      ],
      "visible": false
    },
    {
      "id": "page",
      "type": "group",
      "layers": [
        {
          "id": "bleed_fill",
          "type": "rect",
          "box": { "x": 0, "y": 0, "w": "canvas.w", "h": "canvas.h" },
          "fill": "accent"
        },
        {
          "id": "panel",
          "type": "rect",
          "box": { "x": 160, "y": 160, "w": "canvas.w - 320", "h": "canvas.h - 320" },
          "fill": "soft",
          "radius": 180
        },
        {
          "id": "stitch",
          "type": "rect",
          "box": { "x": 220, "y": 220, "w": "canvas.w - 440", "h": "canvas.h - 440" },
          "fill": "#00000000",
          "radius": 140,
          "stroke": {
            "color": "with_alpha(accent, 0.5)",
            "width": 12,
            "dash": [0.2, 40]
          }
        },
        {
          "id": "left_card",
          "type": "rect",
          "box": { "x": 260, "y": 1300, "w": 1400, "h": 5360 },
          "fill": "paper",
          "radius": 120,
          "stroke": { "color": "with_alpha(accent, 0.35)", "width": 8 }
        },
        {
          "id": "right_card",
          "type": "rect",
          "box": { "x": 1720, "y": 1300, "w": 2980, "h": 5360 },
          "fill": "paper",
          "radius": 120,
          "stroke": { "color": "with_alpha(accent, 0.35)", "width": 8 }
        }
      ]
    },
    {
      "id": "header",
      "type": "group",
      "layers": [
        {
          "id": "shop_title",
          "type": "text",
          "text": "{title}",
          "anchor": "center",
          "font": "script",
          "size": 460,
          "color": "ink",
          "max_width": 3600,
          "min_size": 240,
          "at": { "x": "cx", "y": 640 }
        },
        {
          "id": "shop_sub",
          "type": "text",
          "text": "{upper(subtitle)}",
          "anchor": "center",
          "font": "bold",
          "size": 112,
          "color": "muted",
          "max_width": 3600,
          "min_size": 60,
          "at": { "x": "cx", "y": 1000 }
        },
        {
          "id": "left_head",
          "type": "text",
          "text": "{upper(tr('Getränke', 'Drinks'))}",
          "anchor": "left",
          "font": "bold",
          "size": 84,
          "color": "muted",
          "at": { "x": 380, "y": 1440 }
        },
        {
          "id": "right_head",
          "type": "text",
          "text": "{upper(tr('Einkaufen', 'Shopping'))} · +{num(reserve)} %",
          "anchor": "left",
          "font": "bold",
          "size": 84,
          "color": "muted",
          "at": { "x": 1840, "y": 1440 }
        },
        {
          "id": "total_servings",
          "type": "text",
          "text": "{num(sum(party, 'servings'))} {tr('Gläser insgesamt', 'glasses in total')}",
          "anchor": "center",
          "font": "body",
          "size": 80,
          "color": "ink",
          "at": { "x": 960, "y": 6520 }
        }
      ]
    },
    {
      "id": "party_list",
      "type": "group",
      "layers": [
        {
          "id": "party_row",
          "type": "group",
          "layers": [
            {
              "id": "p_name",
              "type": "text",
              "text": "{name_of(p.drink)}",
              "anchor": "left",
              "font": "body",
              "size": 88,
              "color": "ink",
              "max_width": 940,
              "min_size": 56,
              "shrink_group": "party_names",
              "at": { "x": 0, "y": 0 }
            },
            {
              "id": "p_serv",
              "type": "text",
              "text": "{num(p.servings)} ×",
              "anchor": "right",
              "font": "bold",
              "size": 92,
              "color": "ink",
              "at": { "x": 1280, "y": 0 }
            }
          ],
          "repeat": { "each": "party", "item": "p", "index": "k" },
          "translate": { "x": 320, "y": "list_top + party_pitch * (k + 0.5)" }
        }
      ]
    },
    {
      "id": "shopping_list",
      "type": "group",
      "layers": [
        {
          "id": "shop_row",
          "type": "group",
          "layers": [
            {
              "id": "s_dot",
              "type": "ellipse",
              "anchor": "center",
              "box": { "x": 1840, "y": 0, "w": 68, "h": 68 },
              "fill": "get(catalog, rc.ingredient, 'color', #F4A6B7)",
              "stroke": { "color": "with_alpha(ink, 0.35)", "width": 6 }
            },
            {
              "id": "s_name",
              "type": "text",
              "text": "{name_of(rc.ingredient)}",
              "anchor": "left",
              "font": "body",
              "size": 88,
              "color": "ink",
              "max_width": 1240,
              "min_size": 56,
              "shrink_group": "shop_names",
              "at": { "x": 1960, "y": 0 }
            },
            {
              "id": "s_amount",
              "type": "text",
              "text": "{get(catalog, rc.ingredient, 'unit', 'cl') == 'cl' ? num(round(@need_acc[r].bounds.right) / 10) : num(ceil(round(@need_acc[r].bounds.right) / 10 - 0.001))}",
              "anchor": "right",
              "font": "bold",
              "size": 92,
              "color": "ink",
              "at": { "x": 3800, "y": 0 }
            },
            {
              "id": "s_unit",
              "type": "text",
              "text": "{unit_of(rc.ingredient)}",
              "anchor": "left",
              "font": "body",
              "size": 80,
              "color": "muted",
              "at": { "x": 3832, "y": 0 }
            },
            {
              "id": "s_bottles",
              "type": "text",
              "anchor": "right",
              "font": "body",
              "size": 80,
              "color": "muted",
              "visible": "get(catalog, rc.ingredient, 'bottle', 0) > 0",
              "text": "{tr('≈ ', '≈ ')}{ceil(round(@need_acc[r].bounds.right) / 10 / max(get(catalog, rc.ingredient, 'bottle', 1), 1) - 0.0001)} × {num(get(catalog, rc.ingredient, 'bottle', 0))} cl",
              "at": { "x": 4600, "y": 0 }
            }
          ],
          "repeat": { "each": "recipes", "item": "rc", "index": "r" },
          "visible": "(r + 1 < nrows ? recipes[r + 1].ingredient != rc.ingredient : true) and @need_acc[r].bounds.right > 0",
          "translate": {
            "x": 0,
            "y": "list_top + min(184, 4900 / max(@shop_lines.bounds.w, 1)) * (@line_acc[r].bounds.right - 0.5)"
          }
        }
      ]
    }
  ]
}
